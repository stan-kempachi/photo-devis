# Copier en .env (chmod 600). Ne jamais committer le .env.

# Gmail — mot de passe d'application : https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SMTP (valeurs Gmail par défaut)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT=15

# Fréquence de vérification de la boîte (secondes)
POLL_INTERVAL=60

# Analyse photo (Claude)
ANTHROPIC_API_KEY=votre_cle_api_anthropic

# Coordonnées affichées sur le devis
ENTREPRISE_NOM=Jardin Services Démo
ENTREPRISE_EMAIL=contact@jardin-services-demo.fr
ENTREPRISE_TEL=01 23 45 67 89

# Adresse affichée en expéditeur et sur le devis (doit être un alias « Envoyer en tant que » du compte Gmail)
FROM_EMAIL=stan@votre-domaine.fr
